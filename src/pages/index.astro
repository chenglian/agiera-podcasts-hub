---
import Layout from '../layouts/Layout.astro';
import PodcastCard from '../components/PodcastCard.astro';
import podcasts from '../data/podcasts.json';

---

<Layout>
	<main class="min-h-screen px-4 pb-20">
		<header class="py-12 text-center">
			<h1 class="text-4xl md:text-6xl font-extrabold tracking-tighter mb-4 text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-600">
				AGI Era
			</h1>
			<p class="text-gray-400 text-lg uppercase tracking-widest font-medium">
				Podcast Intelligence Hub
			</p>
		</header>

		<div class="space-y-8">
			{podcasts.map((podcast) => (
				<PodcastCard podcast={podcast} />
			))}
		</div>

		<footer class="mt-24 text-center text-gray-600 text-sm border-t border-gray-900 pt-8">
			<!--<div class="flex justify-center mb-4">
		        <a href="https://twitter.com/agiera_?ref_src=twsrc%5Etfw" 
		           class="twitter-follow-button" 
		           data-size="large" 
		           data-show-count="true"
		           data-theme="dark">
		           Follow this Podcast @agiera_
		        </a>
		    </div>		    
		    <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>-->

			<p>&copy; {new Date().getFullYear()} AGI Era Media Hub by Chenglian Consulting. Automated via n8n.</p>
		</footer>
	</main>
</Layout>
